# ─────────────────────────────────────────────────────────────────
# Environment variable template
# Copy to .env and fill in your values before running docker-compose
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# Spring profile: dev | prod
SPRING_PROFILE=prod

# NYC MTA API key   → https://api.mta.info/
MTA_API_KEY=your-mta-api-key-here

# Transit.land API key → https://www.transit.land/
TRANSITLAND_API_KEY=your-transitland-api-key-here

# TfL API key → https://api.tfl.gov.uk/ (optional - works without key)
TFL_API_KEY=your-tfl-api-key-here

# Cache tuning (seconds)
CACHE_TTL_SECONDS=300
CACHE_STALE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Set to 'true' to always serve mock data (useful for demos / testing)
OFFLINE_MODE=false

# CORS – comma-separated list of allowed UI origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000